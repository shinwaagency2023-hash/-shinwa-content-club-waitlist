# Copy these into Netlify > Site configuration > Environment variables. NEVER commit a real .env file.
BREVO_API_KEY=            # Brevo > SMTP & API > API keys (server-side only)
BREVO_LIST_ID=            # numeric ID of your waitlist list
BREVO_DOI_TEMPLATE_ID=    # optional: numeric ID of your double opt-in template. If empty, single opt-in is used.
BREVO_DOI_REDIRECT_URL=   # where people land after confirming, e.g. https://YOUR-SITE.netlify.app/?confirmed=1
ADMIN_NOTIFY_EMAIL=       # optional: where new-signup alerts go
BREVO_SENDER_EMAIL=       # optional: a sender verified in Brevo (needed for admin alerts)
BREVO_SENDER_NAME=Shinwa Content Club
ALLOWED_ORIGIN=           # optional: your live site origin, e.g. https://YOUR-SITE.netlify.app
VITE_CONTACT_EMAIL=       # public contact address shown in footer and privacy policy
